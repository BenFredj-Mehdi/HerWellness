### Copy this file to `.env` and fill in the secrets. DO NOT commit `.env` to source control.

# Groq API key (set securely)
GROQ_API_KEY=key

# LiveKit configuration (for WebRTC rooms / tokens)
LIVEKIT_URL=https://your-livekit-host.example
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: Port for FastAPI
PORT=8000
